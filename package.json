{
  "name": "feuilleton-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Studio de séries vidéo : scénario, images ChatGPT, clips Grok, voix ElevenLabs, montage ffmpeg, publication TikTok, Instagram et YouTube.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:live": "npm run test:live --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev -w @feuilleton/web",
    "dev:worker": "npm run dev -w @feuilleton/worker",
    "diagnostic": "npm run diagnostic -w @feuilleton/worker"
  },
  "engines": {
    "node": ">=20.11"
  }
}
