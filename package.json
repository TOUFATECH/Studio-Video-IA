{
  "name": "studio-video-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Studio de séries et de clips vidéo : scénario, images ChatGPT, vidéos Grok, voix et musique ElevenLabs, montage ffmpeg, publication TikTok, Instagram et YouTube. Base SQLite locale ou PostgreSQL externe.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:live": "npm run test:live --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev -w @studio-video-ia/web",
    "dev:worker": "npm run dev -w @studio-video-ia/worker",
    "diagnostic": "npm run diagnostic -w @studio-video-ia/worker",
    "sauvegarde": "tsx packages/base/src/sauvegarde-cli.ts",
    "mot-de-passe": "tsx packages/base/src/mot-de-passe-cli.ts"
  },
  "engines": {
    "node": ">=22.13"
  }
}
