# Réglages de Studio Vidéo IA. Copier en « .env » à la racine du dépôt (lu par le site ET le worker).
# Tout est facultatif : sans rien remplir, la base SQLite, le dossier des médias et la clé de chiffrement
# sont créés au premier lancement dans le dossier « donnees ». Ne jamais committer le fichier .env.

# --- Base de données ---
# Vide : base locale SQLite dans DONNEES_DIR/studio.db (par défaut).
# Base externe : une adresse PostgreSQL, par exemple postgres://utilisateur:mot-de-passe@serveur:5432/studio
# (ton serveur, un hébergeur, ou la base d'un projet Supabase : Project Settings → Database → Connection string).
DATABASE_URL=
# Dossier des données (base SQLite, médias, clé générée). Relatif à la racine du dépôt, ou absolu. Docker : /donnees.
DONNEES_DIR=./donnees
# Dossier des médias, si tu veux le mettre ailleurs (disque plus grand…). Par défaut : DONNEES_DIR/medias.
MEDIAS_DIR=

# --- Chiffrement des clés API et des jetons ---
# Vide : une clé est générée au premier lancement dans DONNEES_DIR/cle-chiffrement (garde-la avec tes sauvegardes).
# Sinon : openssl rand -base64 32 (même valeur pour le site et le worker).
ENCRYPTION_KEY=

# --- Adresse du site ---
# Sert aux retours OAuth (TikTok, Instagram, YouTube) et aux liens que télécharge Instagram.
# En local : http://localhost:3000. Pour publier sur Instagram, il faut une adresse https publique (voir docs/INSTALLER.md).
APP_URL=http://localhost:3000
# « fermees » : seul le premier compte peut être créé, les suivants sont refusés.
INSCRIPTIONS=ouvertes

# --- Modèles utilisés (modifiables sans toucher au code) ---
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
# Qualité des images : low, medium ou high (high coûte nettement plus cher)
OPENAI_IMAGE_QUALITY=medium
XAI_VIDEO_MODEL=grok-imagine-video
# 480p, 720p ou 1080p (1080p selon le modèle choisi)
XAI_VIDEO_RESOLUTION=720p
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Clips musicaux : musique générée (music_v1 accepte un plan de composition avec les paroles) et reconnaissance des paroles
ELEVENLABS_MUSIC_MODEL=music_v1
ELEVENLABS_STT_MODEL=scribe_v1
# Claude, si tu choisis Claude au lieu de ChatGPT pour écrire les scènes et les paroles d'un clip
ANTHROPIC_MODEL=claude-sonnet-5-5
# Version de l'API Instagram (graph.instagram.com)
INSTAGRAM_API_VERSION=v25.0

# --- Worker ---
WORKER_NAME=pc-maison
# Nombre de tâches traitées en même temps par ce worker
WORKER_CONCURRENCY=2
# Dossier de travail pour les clips et les rendus
WORKER_TMP_DIR=./tmp
# Chemins de ffmpeg et ffprobe si ce ne sont pas ceux du PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Police pour les sous-titres (doit gérer le japonais et le coréen)
SUBTITLE_FONT=Noto Sans CJK JP

# --- Tests réels (npm run test:live) : clés lues ici, pas en base ---
RUN_LIVE_TESTS=0
OPENAI_API_KEY=
XAI_API_KEY=
ELEVENLABS_API_KEY=
