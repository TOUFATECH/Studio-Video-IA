{
  "name": "@studio-video-ia/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Worker de Studio Vidéo IA : file de tâches, génération IA, rendu ffmpeg, publication programmée et statistiques.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "diagnostic": "tsx src/diagnostic-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --exclude \"tests/live/**\"",
    "test:live": "vitest run tests/live --passWithNoTests"
  },
  "dependencies": {
    "@studio-video-ia/core": "0.1.0",
    "@studio-video-ia/integrations": "0.1.0",
    "@supabase/supabase-js": "^2.119.0",
    "tsx": "^4.23.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
